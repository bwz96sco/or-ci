{
  "mcpServers": {
    "gitnexus": {
      "type": "stdio",
      "command": "gitnexus",
      "args": ["mcp"],
      "env": {}
    },
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--project-from-cwd",
        "--context=claude-code"
      ],
      "env": {
        "MCP_TIMEOUT": "60000"
      }
    }
  }
}
